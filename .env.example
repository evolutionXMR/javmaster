# JavMaster example environment. Copy to .env and fill in your values.
TZ=Australia/Sydney
CONTAINER_NAME=javmaster
PUID=1000
PGID=1000
WEB_PORT=18080

# Web login. Change these before exposing the service.
WEB_USERNAME=admin
WEB_PASSWORD=change-me-now

# Discord bot. Leave disabled in the GUI or blank if you only want the web UI.
DISCORD_BOT_TOKEN=
DISCORD_REPORT_CHANNEL_ID=0

# Gopeed. Use either root URL (http://host:9999) or REST base URL (.../api/v1).
GOPEED_URL=http://gopeed:9999/api/v1
GOPEED_TOKEN=
GOPEED_DOWNLOAD_PATH=/downloads

# Container paths. Host directories are configured below for compose volume mounts.
DATA_DIR=/app/data
CLEANUP_PATH=/downloads
DATA_DIR_HOST=./data
DOWNLOADS_HOST=./downloads

# Optional data-file overrides. Defaults live under DATA_DIR.
# WATCHLIST_FILE=/app/data/watchlist.json
# BOT_TASKS_FILE=/app/data/bot_tasks.json
# ACTRESS_WATCHLIST_FILE=/app/data/actress_watchlist.json
# JAVMASTER_SETTINGS_FILE=/app/data/javmaster_settings.json
# JAVMASTER_RESOURCE_STATE_FILE=/app/data/resource_state.json

# Metadata sources / network
# Scraper tries each source in order until one returns metadata.
METADATA_SOURCE_ORDER=avwikidb,r18dev,fanza,javdb,javbus,javlibrary
AVWIKIDB_BASE_URL=https://avwikidb.com
R18DEV_BASE_URL=https://r18.dev
FANZA_BASE_URL=https://www.dmm.co.jp
JAVDB_BASE_URL=https://javdb.com
JAVBUS_BASE_URL=https://www.javbus.com
JAVLIBRARY_BASE_URL=https://www.javlibrary.com
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1
